HOST=127.0.0.1
PORT=3030
DATA_DIR=./data
DANSER_DIR=/path/to/danser
DANSER_BIN=/path/to/danser/danser-cli
DANSER_BASE_SETTINGS=/path/to/danser/settings/default.json
DANSER_SKINS_DIR=/path/to/danser/skins
OSU_CLIENT_ID=
