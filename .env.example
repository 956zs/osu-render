# osu-render configuration. Copy this file to .env and fill it in.
# Variables already set in the environment take precedence over this file.
# Do not put quotes around values. Relative paths are relative to the repository root.

# --- Server -----------------------------------------------------------------
# Keep 127.0.0.1 unless you set AUTH_TOKEN (see README, "Security notes").
HOST=127.0.0.1
PORT=3030
# Database, replays, videos, beatmap cache, logs and diagnostics reports.
DATA_DIR=./data
# Maximum number of unfinished render jobs.
MAX_QUEUE=20
# If set, every /api/* request needs "Authorization: Bearer <token>".
# Use a long random string, e.g. the output of: node -e "console.log(crypto.randomUUID())"
AUTH_TOKEN=

# --- danser-go --------------------------------------------------------------
# Folder where you extracted the danser release zip. Empty = ./danser inside this repository.
# Windows: forward slashes or plain backslashes, no quotes:
#   DANSER_DIR=C:/danser
#   DANSER_DIR=C:\danser
# Linux:
#   DANSER_DIR=/opt/danser   (absolute path; "~" is not expanded)
DANSER_DIR=
# Optional overrides. Defaults are derived from DANSER_DIR:
#   DANSER_BIN            <DANSER_DIR>/danser-cli (danser-cli.exe on Windows)
#   DANSER_BASE_SETTINGS  <DANSER_DIR>/settings/default.json (optional; danser's defaults if missing)
#   DANSER_SKINS_DIR      <DATA_DIR>/skins
#   DANSER_SETTINGS_NAME  service  -> the service writes <DANSER_DIR>/settings/service.json
#DANSER_BIN=C:/danser/danser-cli.exe
#DANSER_BASE_SETTINGS=C:/danser/settings/default.json
#DANSER_SKINS_DIR=C:/danser/Skins
#DANSER_SETTINGS_NAME=service

# --- Video encoder ----------------------------------------------------------
# auto (default) self-tests GPU encoders and picks the first that works:
#   Windows: h264_nvenc -> h264_amf -> h264_qsv -> libx264
#   Linux:   h264_nvenc -> h264_qsv -> h264_amf -> libx264
# Or force one: h264_nvenc | hevc_nvenc | h264_amf | hevc_amf | h264_qsv | hevc_qsv | libx264
# A forced encoder that fails its self-test falls back to libx264.
RENDER_ENCODER=auto

# --- osu! API ---------------------------------------------------------------
# Create an OAuth application at https://osu.ppy.sh/home/account/edit (OAuth section).
# Client Credentials has no callback; leave the callback URL empty, or use
# http://127.0.0.1:3030/ if the form requires one. Never share the secret.
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# --- Beatmap download -------------------------------------------------------
# Comma-separated .osz download URLs, tried in order. {id} is the beatmapset ID.
BEATMAP_MIRRORS=https://mirror.hinamizawa.ai/api/v1/hinai/d/{id}
