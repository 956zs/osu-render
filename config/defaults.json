{
  "encoders": {
    "autoOrder": {
      "win32": ["h264_nvenc", "h264_amf", "h264_qsv", "libx264"],
      "linux": ["h264_nvenc", "h264_qsv", "h264_amf", "libx264"],
      "default": ["libx264"]
    },
    "selfTest": { "width": 240, "height": 144, "timeoutMs": 20000 }
  },
  "preflight": { "retryIntervalMs": 5000, "softwareFallbackRetryMs": 300000 },
  "render": { "stallTimeoutMs": 120000 },
  "speedProfiles": {
    "default": "balanced",
    "hevcQualityOffset": 2,
    "disableBloom": ["fast"],
    "families": {
      "nvenc": {
        "rateControl": "cq", "qualityKey": "CQ",
        "fast": { "preset": "p1", "quality": 24 },
        "balanced": { "preset": "p4", "quality": 22 },
        "quality": { "preset": "p7", "quality": 20 }
      },
      "amf": {
        "rateControl": "cqp", "qualityKey": "CQ",
        "fast": { "preset": "speed", "quality": 22 },
        "balanced": { "preset": "balanced", "quality": 20 },
        "quality": { "preset": "quality", "quality": 18 }
      },
      "qsv": {
        "rateControl": "icq", "qualityKey": "Quality",
        "fast": { "preset": "veryfast", "quality": 23 },
        "balanced": { "preset": "faster", "quality": 20 },
        "quality": { "preset": "slow", "quality": 15 }
      },
      "x264": {
        "rateControl": "crf", "qualityKey": "CRF",
        "fast": { "preset": "veryfast", "quality": 20 },
        "balanced": { "preset": "faster", "quality": 18 },
        "quality": { "preset": "medium", "quality": 16 }
      }
    }
  },
  "diagnostics": {
    "logTailBytes": 65536,
    "reportLogTailBytes": 4096,
    "recentRenders": 20,
    "issueUrl": "https://github.com/956zs/osu-render/issues/new",
    "issueTemplate": "gpu-report.yml"
  },
  "reportWebhook": {
    "username": "osu-render",
    "timeoutMs": 15000,
    "retryAfterCapMs": 5000,
    "minIntervalMs": 1000,
    "autoLogTailBytes": { "failed": 4096, "completed": 1024 }
  },
  "skins": { "maxOskBytes": 209715200, "maxExtractedBytes": 1073741824, "maxEntries": 10000, "maxNameLength": 100 },
  "update": {
    "enabled": true,
    "checkOnStartup": true,
    "repo": "956zs/osu-render",
    "checkIntervalMs": 600000,
    "apiTimeoutMs": 15000,
    "downloadTimeoutMs": 900000,
    "maxDownloadBytes": 1073741824,
    "maxExtractedBytes": 4294967296,
    "maxEntries": 50000,
    "downloadHosts": ["github.com", "objects.githubusercontent.com", "release-assets.githubusercontent.com"]
  },
  "history": { "defaultLimit": 20, "maxLimit": 100 },
  "localSongs": { "autoDetect": true, "maxFiles": 300000, "progressEvery": 5000 },
  "preview": { "ttlSeconds": 3600 },
  "i18n": { "languages": ["en", "zh-TW", "es"], "fallback": "en" }
}
