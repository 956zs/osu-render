{
  "name": "osu-render",
  "version": "0.2.0",
  "description": "Self-hosted osu! replay (.osr) to MP4 render service powered by danser-go, with NVIDIA/AMD/Intel GPU encoding on Windows and Linux",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.json",
    "doctor": "node dist/src/doctor.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "@fastify/multipart": "^9.2.1",
    "better-sqlite3": "^12.6.2",
    "fastify": "^5.6.2",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "@types/yauzl": "^3.1.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
